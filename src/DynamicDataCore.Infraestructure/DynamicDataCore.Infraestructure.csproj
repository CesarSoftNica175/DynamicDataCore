<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net8.0</TargetFramework>
	  <PackageId>DynamicDataCore</PackageId>
	  <Version>1.0.2</Version>
	  <Authors>César Adolfo Solís Alvarez</Authors>
	  <Company>NicaSoft</Company>
	  <Description>Lightweight and extensible data access framework for .NET applications.</Description>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <RepositoryUrl>https://github.com/CesarSoftNica175/DynamicDataCore</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/CesarSoftNica175/DynamicDataCore</PackageProjectUrl>

	  <!-- Habilitar Nullable Reference Types -->
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicDataCore.Abstractions\DynamicDataCore.Abstractions.csproj" />
  </ItemGroup>

</Project>
