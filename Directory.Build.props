<Project>
  <!-- EF Core / Microsoft.Extensions.* line follows the target framework:
       net8.0 -> 9.x (last EF Core line supporting net8.0), net10.0 -> 10.x. -->
  <PropertyGroup>
    <EfCoreVersion>9.0.11</EfCoreVersion>
    <MsExtensionsVersion>9.0.11</MsExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EfCoreVersion>10.0.12</EfCoreVersion>
    <MsExtensionsVersion>10.0.12</MsExtensionsVersion>
  </PropertyGroup>

  <!-- Exclude AI guide files from NuGet packages -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)CLAUDE.md" />
    <None Remove="$(MSBuildThisFileDirectory)AGENTS.md" />
    <Content Remove="$(MSBuildThisFileDirectory)CLAUDE.md" />
    <Content Remove="$(MSBuildThisFileDirectory)AGENTS.md" />
  </ItemGroup>

  <!-- Raw-SQL lock: published libraries may not use raw SQL / CommandText APIs (see BannedSymbols.txt).
       Test projects are excluded so they can seed schemas with plain ADO.NET. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'DynamicDataCore.Tests'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'DynamicDataCore.Tests'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
